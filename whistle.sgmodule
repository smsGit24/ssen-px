#!name=WhistleProxy
#!desc=浏览器App进程走Whistle代理，需要创建名称为Dev-Whistle-local的whistle代理节点，并且该节点应该在规则最上方，防止先被surge其他规则污染
#!category=开发
#!system=mac

[Rule]
# 解决开发调试-Whistle
PROCESS-NAME,Google Chrome*,Dev-Whistle-local // Chrome-Whistle代理
PROCESS-NAME,firefox*,Dev-Whistle-local // FF-Whistle代理
PROCESS-NAME,Microsoft Edge*,Dev-Whistle-local // Edge-Whistle代理
PROCESS-NAME,Arc*,Dev-Whistle-local // Arc-Whistle代理
OR,((PROCESS-NAME,WebKit Networking*), (PROCESS-NAME,/System/Volumes/Preboot/Cryptexes/OS/System/Library/Frameworks/WebKit.framework/Versions/A/XPCServices/com.apple.WebKit.Networking.xpc/Contents/MacOS/com.apple.WebKit.Networking)),Dev-Whistle-local // 钉钉-企微-Whistle代理